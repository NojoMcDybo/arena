{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arena",
  "version": "0.1.0",
  "identifier": "de.nojo.arena",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1434",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Arena",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1c1c1e",
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["arena"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
